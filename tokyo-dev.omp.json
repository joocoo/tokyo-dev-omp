          }
        },
        {
          "type": "r",
          "style": "diamond",
          "foreground": "#98bfad",
          "template": "{{ with .Full }}[<#ffffff>\ue68a</> {{ . }}]{{ end }}",
          "options": {
            "display_mode": "files"
          }
        },
        {
          "type": "ruby",
          "style": "diamond",
          "foreground": "#98bfad",
          "template": "{{ with .Full }}[<#ffffff>\ue791</> {{ . }}]{{ end }}",
          "options": {
            "display_mode": "files"
          }
        },
        {
          "type": "swift",
          "style": "diamond",

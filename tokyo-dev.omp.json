          }
        },
        {
          "type": "vala",
          "style": "diamond",
          "foreground": "#98bfad",
          "template": "{{ with .Full }}[<#ffffff>\ue69e</> {{ . }}]{{ end }}",
          "options": {
            "display_mode": "files"
          }
        },
        {
          "type": "zig",
          "style": "diamond",
          "foreground": "#98bfad",
          "template": "{{ with .Full }}[<#ffffff>\ue6a9</> {{ . }}]{{ end }}",
          "options": {
            "display_mode": "files"
          }
        },
        {
          "type": "cmake",
          "style": "diamond",
          "foreground": "#98bfad",
          "template": "{{ with .Full }}[<#ffffff>\ue794</> {{ . }}]{{ end }}",
          "options": {
            "display_mode": "files",
            "project_files": [
              "CMakeLists.txt"
            ]
          }
        },
        {
          "type": "language",
          "style": "diamond",
          "foreground": "#98bfad",
          "template": "{{ with .Full }}[<#ffffff>\ue771</> {{ . }}]{{ end }}",
          "options": {
            "name": "c",
            "display_mode": "files",
            "extensions": [
              "*.c"
            ],
            "tools": [
              {
                "name": "cc",
                "executable": "cc",
                "args": [
                  "--version"
                ],
                "regex": "^[^\\r\\n]*?(?P<version>\\d+\\.\\d+(?:\\.\\d+)?)"
              },
              {
                "name": "clang",
                "executable": "clang",
                "args": [
                  "--version"
                ],
                "regex": "^[^\\r\\n]*?(?P<version>\\d+\\.\\d+(?:\\.\\d+)?)"
              },
              {
                "name": "gcc",
                "executable": "gcc",
                "args": [
                  "--version"
                ],
                "regex": "^[^\\r\\n]*?(?P<version>\\d+\\.\\d+(?:\\.\\d+)?)"
              }
            ]
          }
        },
        {
          "type": "language",
          "style": "diamond",
          "foreground": "#98bfad",
          "template": "{{ with .Full }}[<#ffffff>\ue7a3</> {{ . }}]{{ end }}",
          "options": {
            "name": "cpp",
            "display_mode": "files",
            "extensions": [
              "*.cpp",
              "*.cc",
              "*.cxx",
              "*.c++",
              "*.cppm",
              "*.ixx",
              "*.hpp",
              "*.hh",
              "*.hxx",
              "*.h++"
            ],
            "tools": [
              {
                "name": "c++",
                "executable": "c++",
                "args": [
                  "--version"
                ],
                "regex": "^[^\\r\\n]*?(?P<version>\\d+\\.\\d+(?:\\.\\d+)?)"
              },
              {
                "name": "clang++",
                "executable": "clang++",
                "args": [
                  "--version"
                ],
                "regex": "^[^\\r\\n]*?(?P<version>\\d+\\.\\d+(?:\\.\\d+)?)"
              },
              {
                "name": "g++",
                "executable": "g++",
                "args": [
                  "--version"
                ],
                "regex": "^[^\\r\\n]*?(?P<version>\\d+\\.\\d+(?:\\.\\d+)?)"
              }
            ]
          }
        },
        {
          "type": "docker",
          "style": "diamond",
          "foreground": "#7eb8da",
          "template": "[<#ffffff>\uf308</>{{ with .Context }} {{ if contains \"://\" . }}remote{{ else }}{{ . }}{{ end }}{{ end }}]",
          "options": {
            "display_mode": "files",
            "fetch_context": true,
            "extensions": [
              "Dockerfile",
              "Dockerfile.*",
              "*.Dockerfile",
              "compose.yml",
              "compose.yaml",
              "docker-compose.yml",
              "docker-compose.yaml"
            ]
          }
        },
        {
          "type": "language",
          "style": "diamond",
          "foreground": "#be9ddf",
          "template": "{{ with .Full }}[<#ffffff>\ue866</> {{ . }}]{{ end }}",
          "options": {
            "name": "podman",
            "display_mode": "files",
            "extensions": [
              "Containerfile",
              "Containerfile.*",
              "*.container",
              "*.pod",
              "*.kube",
              "compose.yml",
              "compose.yaml",
              "docker-compose.yml",
              "docker-compose.yaml"
            ],
            "tools": [
              {
                "name": "podman",
                "executable": "podman",
                "args": [
                  "--version"
                ],
                "regex": "(?i)^podman version (?P<version>\\d+\\.\\d+\\.\\d+(?:[-+~][0-9a-z.+~-]+)?)"
              }
            ]
          }
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "leading_diamond": "<#7eb8da>\u2523</>",
      "segments": [
        {
          "foreground": "#7eb8da",
          "options": {
            "style": "full"
          },
          "style": "diamond",
          "template": "[<#ffffff>\uf115</> <#98bfad>{{ .Path }}</>]",
          "type": "path"
        },
        {
          "foreground": "#ffa5d8",
          "style": "plain",
          "template": "[<#ffffff>{{ .UpstreamIcon }} </>{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} <#ffffff>\uf044</> {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} <#ffffff>\uf046</> {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} <#ffffff>\ueb4b</> {{ .StashCount }}{{ end }}]",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "leading_diamond": "<#7eb8da>\u2514\u2500</>",
      "segments": [
        {
          "style": "diamond",
          "template": "<#ffff00>[#]</>",
          "type": "root"
        },
        {
          "foreground": "#ffa5d8",
          "style": "diamond",
          "template": "[<#ffffff>\uea6c</> Error, check your command]",
          "type": "status"
        },
        {
          "style": "diamond",
          "template": ">",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "secondary_prompt": {
    "background": "transparent",
    "template": " "
  },
  "valid_line": {
    "background": "transparent",
    "template": "> "
  },
  "error_line": {
    "background": "transparent",
    "template": "<#ff0000>\uea87</> "
  },
  "version": 4
}
